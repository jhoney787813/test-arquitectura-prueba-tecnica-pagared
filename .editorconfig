root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# Los CSV de entrada conservan sus bytes originales (encoding y CRLF del core).
[*.csv]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
