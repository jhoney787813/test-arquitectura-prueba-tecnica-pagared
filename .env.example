# Copie este archivo como .env y ajuste los valores del entorno local.
# NUNCA versione un .env con credenciales reales.
#
# El pipeline de la prueba funciona con valores por defecto y no requiere
# credenciales: la base es SQLite y el reporte se genera como archivo.

# Ruta de la base de datos (SQLite). Relativa a la raíz del repositorio.
PAGARED_DB_PATH=db/pagared.db

# Carpeta donde se generan los reportes y artefactos de salida.
PAGARED_SALIDA_DIR=salida

# Nivel de log: DEBUG | INFO | WARNING | ERROR
PAGARED_LOG_LEVEL=INFO

# Zona horaria de negocio para delimitar el día (el core exporta en UTC).
PAGARED_TZ=America/Bogota

# Envío de correo. En la prueba no hay servidor SMTP de la empresa:
# el pipeline genera el reporte y un borrador .eml listo para enviar.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# REPORTE_DESTINATARIO=laura.restrepo@pagared.com
