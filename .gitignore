# Base de datos local generada por el pipeline
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm

# Logs de ejecución (se versiona solo la carpeta)
logs/*.log
logs/*.log.*

# Archivos temporales
*.tmp
*.bak
~$*

# Sistema operativo / editor
.DS_Store
.idea/
.vscode/
