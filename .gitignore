# Entornos virtuales
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Herramientas
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Secretos: nunca versionar .env reales
